# All optional. With none of these set, raglab runs offline (see README, "Two modes").
RAGLAB_API_KEY=            # an OpenAI-compatible key, for example OpenRouter
RAGLAB_BASE_URL=https://openrouter.ai/api/v1
RAGLAB_MODEL=              # answer, SQL and planning model
RAGLAB_EMBED_MODEL=        # embedding model
RAGLAB_JUDGE_MODEL=        # grading model; use a different model from RAGLAB_MODEL
RAGLAB_VISION_MODEL=       # only for page-image reading
RAGLAB_DSN=                # Postgres connection string; omit for the in-memory store
